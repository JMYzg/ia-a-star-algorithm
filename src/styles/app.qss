QWidget {
    background: #eef0f2;
    color: #353b3c;
    font-size: 12px;
}

QSplitter::handle {
    background: #353b3c;
    width: 1px;
}

QSplitter::handle:hover {
    background: #846a6a;
}

QLineEdit {
    background: #eef0f2;
    border: 1px solid #353b3c;
    padding: 4px 6px;
    selection-background-color: #846a6a;
}

QLineEdit:focus {
    border: 1px solid #846a6a;
}

QLineEdit:disabled {
    border: 1px solid #a2999e;
    color: #a2999e;
}

QCheckBox {
    spacing: 6px;
    background: transparent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #353b3c;
    background: #eef0f2;
}

QCheckBox::indicator:hover {
    background: #c6c7c4;
}

QCheckBox::indicator:checked {
    background: #846a6a;
}

QCheckBox:disabled {
    color: #a2999e;
}

QCheckBox::indicator:disabled {
    border: 1px solid #a2999e;
}

#colorSwatch {
    border: 1px solid #353b3c;
    padding: 0;
}

#colorSwatch:hover {
    border: 1px solid #846a6a;
}

QScrollBar:vertical {
    background: #eef0f2;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #353b3c;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #846a6a;
}

QScrollBar:horizontal {
    background: #eef0f2;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #353b3c;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #846a6a;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    background: #353b3c;
    color: #eef0f2;
    border: 1px solid #846a6a;
    padding: 4px 8px;
}

QStatusBar {
    background: #353b3c;
    color: #eef0f2;
}

QStatusBar::item {
    border: none;
}

QMessageBox {
    background: #eef0f2;
}

QMessageBox QLabel {
    background: transparent;
}

QMessageBox QPushButton {
    background: #eef0f2;
    border: 1px solid #353b3c;
    padding: 6px 18px;
    min-width: 64px;
}

QMessageBox QPushButton:hover {
    background: #c6c7c4;
}

QMessageBox QPushButton:default {
    background: #353b3c;
    color: #eef0f2;
}

#sidebar {
    background: #eef0f2;
    border-left: 1px solid #353b3c;
}

#sidebarSection {
    background: #eef0f2;
    border-bottom: 1px solid #353b3c;
}

#sidebarSectionTitle {
    background: #353b3c;
    color: #eef0f2;
    padding: 6px 10px;
    font-weight: bold;
}

#sectionPlaceholder {
    background: #eef0f2;
    color: #a2999e;
}

#boardToolbar {
    background: #eef0f2;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton {
    background: #eef0f2;
    border: 1px solid transparent;
    color: #353b3c;
    padding: 8px 10px;
    min-width: 72px;
}

#boardToolbar QToolButton:hover {
    background: #c6c7c4;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton:checked {
    background: #846a6a;
    color: #eef0f2;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton#solveButton {
    background: #353b3c;
    color: #eef0f2;
    margin-top: 8px;
}

#boardToolbar QToolButton#solveButton:hover {
    background: #846a6a;
}

#boardToolbar QToolButton#solveButton:checked {
    background: #846a6a;
    color: #eef0f2;
}

#solveProgressBar {
    background: #c6c7c4;
    border: none;
    color: #eef0f2;
    font-weight: bold;
}

#solveProgressBar::chunk {
    background: #353b3c;
}

#emptyHint {
    background: transparent;
    color: #a2999e;
    font-style: italic;
}

QTableWidget {
    background: #eef0f2;
    border: none;
    gridline-color: #c6c7c4;
    selection-background-color: #846a6a;
}

QHeaderView::section {
    background: #353b3c;
    color: #eef0f2;
    padding: 4px 8px;
    border: none;
}
