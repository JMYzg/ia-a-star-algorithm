QWidget {
    background: #eef0f2;
    color: #353b3c;
    font-size: 12px;
}

QSplitter::handle {
    background: #353b3c;
    width: 1px;
}

#sidebar {
    background: #eef0f2;
    border-left: 1px solid #353b3c;
}

#sidebarSection {
    background: #eef0f2;
    border-bottom: 1px solid #353b3c;
}

#sidebarSectionTitle {
    background: #353b3c;
    color: #eef0f2;
    padding: 6px 10px;
    font-weight: bold;
}

#sectionPlaceholder {
    background: #eef0f2;
    color: #a2999e;
}

#boardToolbar {
    background: #eef0f2;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton {
    background: #eef0f2;
    border: 1px solid transparent;
    color: #353b3c;
    padding: 8px 10px;
    min-width: 72px;
}

#boardToolbar QToolButton:hover {
    background: #c6c7c4;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton:checked {
    background: #846a6a;
    color: #eef0f2;
    border: 1px solid #353b3c;
}

#boardToolbar QToolButton#solveButton {
    background: #353b3c;
    color: #eef0f2;
    margin-top: 8px;
}

#boardToolbar QToolButton#solveButton:hover {
    background: #846a6a;
}

#boardToolbar QToolButton#solveButton:checked {
    background: #846a6a;
    color: #eef0f2;
}

#solveProgressBar {
    background: #c6c7c4;
    border: none;
}

#solveProgressBar::chunk {
    background: #353b3c;
}

QTableWidget {
    background: #eef0f2;
    border: none;
    gridline-color: #c6c7c4;
    selection-background-color: #846a6a;
}

QHeaderView::section {
    background: #353b3c;
    color: #eef0f2;
    padding: 4px 8px;
    border: none;
}
